! Shift in BYPASS(0xFF) instruction
SIR	8	TDI  (FF);
RUNTEST	IDLE	100 TCK	1.00E-002 SEC;


! Verify USERCODE

! Shift in READ USERCODE(0xC0) instruction
SIR	8	TDI  (C0);
RUNTEST	IDLE	2 TCK	1.00E-003 SEC;
SDR	32	TDI  (00000000)
		TDO  (00000000)
		MASK (FFFFFFFF);


! Exit the programming mode

! Shift in ISC DISABLE(0x26) instruction
SIR	8	TDI  (26);
RUNTEST	IDLE	2 TCK	2.00E-001 SEC;
! Shift in BYPASS(0xFF) instruction
SIR	8	TDI  (FF);
RUNTEST	IDLE	2 TCK	1.00E-003 SEC;


! Verify Status Register

! Shift in LSC_READ_STATUS(0x3C) instruction
SIR	8	TDI  (3C);
SDR	32	TDI  (00000000)
		TDO  (00000100)
		MASK (00002100);
