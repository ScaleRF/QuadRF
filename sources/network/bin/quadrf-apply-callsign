#!/bin/bash
# Persist CALLSIGN into /etc/quadrf/quadrf.conf.
# Called by the web GUI via sudoers and by operators from the command line.
set -euo pipefail

. "${QUADRF_FUNCTIONS:-/usr/share/quadrf/functions.sh}"

usage() {
    echo "usage: quadrf-apply-callsign <callsign>" >&2
    exit 1
}

[ $# -ge 1 ] || usage
RAW="$1"

# Trim whitespace and convert to uppercase
CALLSIGN="$(printf '%s' "${RAW}" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"

if [ "${#CALLSIGN}" -lt 1 ] || [ "${#CALLSIGN}" -gt 16 ]; then
    echo "quadrf-apply-callsign: callsign must be 1-16 characters" >&2
    exit 1
fi

if ! printf '%s' "${CALLSIGN}" | grep -qE '^[A-Z0-9/-]+$'; then
    echo "quadrf-apply-callsign: invalid callsign '${RAW}' (allowed: A-Z, 0-9, -, /)" >&2
    exit 1
fi

quadrf_conf_set CALLSIGN "${CALLSIGN}"
if grep -qE "^[[:space:]]*#?[[:space:]]*QUADRF_CALLSIGN=" "${QUADRF_CONF:-/etc/quadrf/quadrf.conf}"; then
    quadrf_conf_set QUADRF_CALLSIGN "${CALLSIGN}"
fi

echo "quadrf-apply-callsign: CALLSIGN=${CALLSIGN}"
