#!/bin/bash
# Write a new wpa_supplicant network. Does not change client/AP mode;
# the GUI toggles that with quadrf-hotspot sta|ap|off.
# Called by the web GUI through the sudoers rule in /etc/sudoers.d/quadrf.
set -euo pipefail

. /usr/share/quadrf/functions.sh
quadrf_load_conf

SSID="${1:?usage: quadrf-apply-wifi <ssid> [passphrase]}"
PSK="${2:-}"
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf

install -d -m 755 "$(dirname "${WPA_CONF}")"

{
    echo 'ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev'
    echo 'update_config=1'
    echo 'country=US'
    echo
    echo 'network={'
    printf '    ssid="%s"\n' "${SSID}"
    if [[ -n "${PSK}" ]]; then
        printf '    psk="%s"\n' "${PSK}"
    else
        echo '    key_mgmt=NONE'
    fi
    echo '}'
} > "${WPA_CONF}"
# GUI (QUADRF_USER) needs the SSID to show in Network Setup; not world-readable.
chown root:"${QUADRF_USER}" "${WPA_CONF}"
chmod 640 "${WPA_CONF}"
