#!/bin/bash
# Bring eth0 up as a LAN client when DHCP answers, otherwise as a
# direct-connect island at 10.55.1.1. quadrf-ethernet.service runs
# "watch" and follows carrier; ifup and "quadrf apply" call start.
#
# The watch loop must not fork while the link is healthy. JTAG is bit-banged
# over RP1, and an exec of ip (libraries faulted in, page cache touched)
# stalls those MMIO reads for about a millisecond. Carrier is a sysfs read.
# IPv4 address changes come from one long-lived netlink monitor.
set -euo pipefail

. /usr/share/quadrf/functions.sh
quadrf_load_conf

IFACE=eth0
DIRECT_ADDR=10.55.1.1
DIRECT_CONF=/etc/dnsmasq.d/quadrf-eth0-direct.conf
LAN_CONF=/etc/dnsmasq.d/quadrf-eth0-lan.conf
DHCP_WAIT=12
CARRIER_WAIT=5
PIDFILE=/run/quadrf-ethernet.pid
LOCKFILE=/run/quadrf-ethernet.lock
ADDR_FIFO=/run/quadrf-ethernet.addr
DHCP_CL_CONF="/run/quadrf/dhclient.${IFACE}.conf"
# empty | lan | direct. Written by enter_lan / enter_direct / leave_link
# and by the address monitor. The watch loop does not poll ip to learn this.
addr_cache=empty
mon_pid=
addr_fd_open=

log() { logger -t quadrf-ethernet -- "$*"; echo "$*"; }

restart_dnsmasq() {
    # SIGHUP only refreshes dnsmasq's hosts and leases; it does not reread
    # snippets in /etc/dnsmasq.d. Do not block the link watcher on the restart.
    systemctl restart --no-block dnsmasq.service 2>/dev/null || true
}

write_conf() {
    dest="$1"
    tmp="$(mktemp)"
    cat > "${tmp}"
    if [[ ! -f "${dest}" ]] || ! cmp -s "${tmp}" "${dest}"; then
        install -m 644 "${tmp}" "${dest}"
        restart_dnsmasq
    fi
    rm -f "${tmp}"
}

drop_conf() {
    dest="$1"
    if [[ -f "${dest}" ]]; then
        rm -f "${dest}"
        restart_dnsmasq
    fi
}

global_v4() {
    ip -4 -o addr show dev "${IFACE}" scope global 2>/dev/null | awk '{print $4}'
}

lan_v4() {
    global_v4 | grep -v '^10\.55\.1\.' || true
}

has_direct() {
    global_v4 | grep -q '^10\.55\.1\.'
}

has_carrier() {
    local c
    [[ -r /sys/class/net/${IFACE}/carrier ]] || return 1
    # Admin-down: the carrier file read fails. That is "no carrier".
    IFS= read -r c 2>/dev/null < /sys/class/net/${IFACE}/carrier || return 1
    [[ "${c}" == 1 ]]
}

iface_exists() {
    [[ -d /sys/class/net/${IFACE} ]]
}

# IFF_UP is bit 0 of /sys/class/net/$IFACE/flags. Fork ip only when the
# interface was actually brought down.
ensure_up() {
    local flags n
    [[ -r /sys/class/net/${IFACE}/flags ]] || return 0
    IFS= read -r flags 2>/dev/null < /sys/class/net/${IFACE}/flags || return 0
    n=$((flags))
    if (( (n & 1) == 0 )); then
        ip link set dev "${IFACE}" up 2>/dev/null || true
    fi
}

# One ip invocation. On failure keep the previous cache: declaring the
# link empty would make the watcher drop a live lease.
refresh_addr_cache() {
    local line addr raw seen_lan=0 seen_direct=0
    raw=$(ip -4 -o addr show dev "${IFACE}" scope global 2>/dev/null) || return 0
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        addr=${line#* inet }
        [[ "${addr}" == "${line}" ]] && continue
        addr=${addr%% *}
        [[ -z "${addr}" ]] && continue
        if [[ "${addr}" == 10.55.1.* ]]; then
            seen_direct=1
        else
            seen_lan=1
        fi
    done <<< "${raw}"
    if [[ "${seen_lan}" -eq 1 ]]; then
        addr_cache=lan
    elif [[ "${seen_direct}" -eq 1 ]]; then
        addr_cache=direct
    else
        addr_cache=empty
    fi
}

# kill -0 is true for a zombie, so read the state and reap it. Otherwise a
# dead monitor looks alive and address changes are missed from then on.
addr_mon_alive() {
    local stat
    [[ -n "${mon_pid}" ]] || return 1
    if ! IFS= read -r stat 2>/dev/null < /proc/"${mon_pid}"/stat; then
        wait "${mon_pid}" 2>/dev/null || true
        mon_pid=
        return 1
    fi
    stat=${stat##*) }
    stat=${stat%% *}
    if [[ "${stat}" == Z ]]; then
        wait "${mon_pid}" 2>/dev/null || true
        mon_pid=
        return 1
    fi
    return 0
}

stop_addr_mon() {
    if [[ -n "${mon_pid}" ]]; then
        kill "${mon_pid}" 2>/dev/null || true
        wait "${mon_pid}" 2>/dev/null || true
        mon_pid=
    fi
    if [[ -n "${addr_fd_open}" ]]; then
        exec 8<&- || true
        addr_fd_open=
    fi
    rm -f "${ADDR_FIFO}"
}

# Long-lived RTM_NEWADDR/RTM_DELADDR feed. Line-buffered so one address
# event is not stuck behind stdio's 4k block. 9>&- so this child does not
# inherit the flock fd; pdeathsig so a killed watcher does not leak it.
start_addr_mon() {
    if addr_mon_alive; then
        return 0
    fi
    if [[ -z "${addr_fd_open}" ]]; then
        rm -f "${ADDR_FIFO}"
        mkfifo -m 600 "${ADDR_FIFO}"
    fi
    if command -v setpriv >/dev/null 2>&1; then
        setpriv --pdeathsig SIGKILL -- \
            stdbuf -oL ip -4 monitor address dev "${IFACE}" > "${ADDR_FIFO}" 9>&- &
    else
        stdbuf -oL ip -4 monitor address dev "${IFACE}" > "${ADDR_FIFO}" 9>&- &
    fi
    mon_pid=$!
    if [[ -z "${addr_fd_open}" ]]; then
        exec 8<> "${ADDR_FIFO}"
        addr_fd_open=1
    fi
}

# 0 = at least one queued address line, 1 = quiet. The line text is not
# trusted; refresh_addr_cache re-reads the addresses.
#
# read -t 0 only polls. A fifo at EOF is readable, and that poll stays
# true without consuming the EOF, so `while read -t 0` spins the watcher
# and the monitor is never restarted. A positive timeout does the read.
drain_addr_events() {
    local line
    [[ -n "${addr_fd_open}" ]] || return 1
    IFS= read -t 0 -r line <&8 || return 1
    if ! IFS= read -t 0.05 -r line <&8; then
        return 1
    fi
    while IFS= read -t 0.05 -r line <&8; do
        :
    done
    return 0
}

watch_pid() {
    local pid
    pid="$(cat "${PIDFILE}" 2>/dev/null)" || return 1
    [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

kick_watch() {
    kill -USR1 "$(cat "${PIDFILE}")" 2>/dev/null || true
}

enter_lan() {
    drop_conf "${DIRECT_CONF}"
    write_conf "${LAN_CONF}" <<EOF
interface=${IFACE}
no-dhcp-interface=${IFACE}
interface-name=${QUADRF_HOSTNAME}.local,${IFACE}
interface-name=${QUADRF_HOSTNAME},${IFACE}
interface-name=$(quadrf_desktop_mdns),${IFACE}
interface-name=$(quadrf_desktop_mdns_short),${IFACE}
EOF
    log "${IFACE} on LAN at $(lan_v4 | tr '\n' ' ')"
    refresh_addr_cache
    quadrf_sync_time
}

enter_direct() {
    ip addr add "${DIRECT_ADDR}/24" dev "${IFACE}" 2>/dev/null || true
    drop_conf "${LAN_CONF}"
    write_conf "${DIRECT_CONF}" <<EOF
interface=${IFACE}
dhcp-range=set:${IFACE},10.55.1.2,10.55.1.10,255.255.255.0,12h
dhcp-option=tag:${IFACE},3
dhcp-option=tag:${IFACE},6,${DIRECT_ADDR}
dhcp-option=tag:${IFACE},15,link
domain=link
interface-name=${QUADRF_HOSTNAME}.local,${IFACE}
interface-name=${QUADRF_HOSTNAME},${IFACE}
interface-name=$(quadrf_desktop_mdns),${IFACE}
interface-name=$(quadrf_desktop_mdns_short),${IFACE}
EOF
    log "${IFACE} direct-connect at ${DIRECT_ADDR}"
    refresh_addr_cache
}

# Stock dhclient.conf leaves reboot at 10s and timeout at 60s. An outer
# kill of DHCP_WAIT (12s) then lands while dhclient is still REQUESTing
# the previous address, so it never sends DISCOVER. A silent REQUEST
# (PHY still dropping frames) becomes "no router" and we go direct.
write_dhclient_conf() {
    install -d -m 755 /run/quadrf
    {
        if [[ -f /etc/dhcp/dhclient.conf ]]; then
            awk '
                /^[[:space:]]*#/ { next }
                /^[[:space:]]*$/ { next }
                /^[[:space:]]*(reboot|timeout|select-timeout|initial-interval)[[:space:]]/ { next }
                { print }
            ' /etc/dhcp/dhclient.conf
        fi
        printf '%s\n' \
            'reboot 3;' \
            'timeout 10;' \
            'select-timeout 3;' \
            'initial-interval 1;'
    } > "${DHCP_CL_CONF}"
}

try_dhcp() {
    if command -v dhclient >/dev/null; then
        write_dhclient_conf
        timeout "${DHCP_WAIT}" dhclient -1 \
            -cf "${DHCP_CL_CONF}" \
            -pf "/run/dhclient.${IFACE}.pid" \
            -lf "/var/lib/dhcp/dhclient.${IFACE}.leases" \
            "${IFACE}" >/dev/null 2>&1 || true
    elif command -v dhcpcd >/dev/null; then
        timeout "${DHCP_WAIT}" dhcpcd -1 -w --timeout "${DHCP_WAIT}" "${IFACE}" >/dev/null 2>&1 || true
    fi
}

stop_dhcp() {
    if command -v dhclient >/dev/null; then
        timeout 2 dhclient -r \
            -pf "/run/dhclient.${IFACE}.pid" \
            -lf "/var/lib/dhcp/dhclient.${IFACE}.leases" \
            "${IFACE}" >/dev/null 2>&1 || true
        pkill -f "dhclient.*${IFACE}" >/dev/null 2>&1 || true
        rm -f "/run/dhclient.${IFACE}.pid"
    fi
    if command -v dhcpcd >/dev/null; then
        dhcpcd -k "${IFACE}" >/dev/null 2>&1 || true
    fi
}

dhcp_client_running() {
    if command -v dhclient >/dev/null; then
        local pid
        [[ -r "/run/dhclient.${IFACE}.pid" ]] || return 1
        read -r pid < "/run/dhclient.${IFACE}.pid" || return 1
        [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
    elif command -v dhcpcd >/dev/null; then
        pgrep -f "dhcpcd.*${IFACE}" >/dev/null
    else
        return 1
    fi
}

# DHCP server / router still on this L2. ICMP may be filtered; ARP
# completed by ping is enough. Ignore STALE — that is the old hop
# after the cable moved.
on_link() {
    local t="$1"
    ping -n -c 1 -W 1 -I "${IFACE}" "${t}" >/dev/null 2>&1 && return 0
    ip -4 neigh show to "${t}" dev "${IFACE}" 2>/dev/null |
        grep -qE ' (REACHABLE|DELAY|PERMANENT)$'
}

lease_targets() {
    local t lease
    t="$(ip -4 route show default dev "${IFACE}" 2>/dev/null | awk '{print $3; exit}')"
    [[ -n "${t}" ]] && printf '%s\n' "${t}"
    for lease in "/var/lib/dhcp/dhclient.${IFACE}.leases" /var/lib/dhcp/dhclient.leases; do
        [[ -f "${lease}" ]] || continue
        awk -v iface="${IFACE}" '
            $1 == "lease" { inlease = 1; ours = 0 }
            inlease && /interface/ && index($0, iface) { ours = 1 }
            inlease && ours && /dhcp-server-identifier|option routers/ {
                gsub(/;/, "", $3)
                print $3
            }
        ' "${lease}"
    done
}

lease_alive() {
    [[ -n "$(lan_v4)" ]] || return 1
    local t seen="|"
    while read -r t; do
        [[ -z "${t}" || "${seen}" == *"|${t}|"* ]] && continue
        seen+="${t}|"
        on_link "${t}" && return 0
    done < <(lease_targets)
    return 1
}

# Pi 5 macb + BCM54213PE drops the first frames after LPI wake. With a
# Realtek r8169 peer, 1 s pings lost 57% with EEE on, 0% with it off.
# Setting EEE renegotiates the link, so only write it when it is on or
# the carrier bounce retriggers the watcher forever.
disable_eee() {
    command -v ethtool >/dev/null || return 0
    ethtool --show-eee "${IFACE}" 2>/dev/null |
        grep -q 'EEE status: enabled' || return 0
    if ethtool --set-eee "${IFACE}" eee off 2>/dev/null; then
        log "disabled EEE on ${IFACE}"
        # set-eee restarts PHY auto-negotiation (3.3-4.1s typical on BCM54213PE).
        # Wait for carrier to drop, then wait up to 8s for it to re-establish.
        sleep 0.5
        local deadline=$((SECONDS + 8))
        while (( SECONDS < deadline )); do
            has_carrier && break
            sleep 0.2
        done
        has_carrier && sleep 1
    fi
}

leave_link() {
    addr_cache=empty
    stop_dhcp
    ip addr flush dev "${IFACE}" scope global 2>/dev/null || true
    drop_conf "${DIRECT_CONF}"
    drop_conf "${LAN_CONF}"
    rm -f "${DHCP_CL_CONF}"
}

configure_locked() {
    ip link show "${IFACE}" &>/dev/null || {
        log "no ${IFACE}, skipping"
        return
    }
    ip link set dev "${IFACE}" up || true
    if ! has_carrier; then
        log "no carrier on ${IFACE}"
        leave_link
        return
    fi
    disable_eee
    if ! has_carrier; then
        log "no carrier on ${IFACE}"
        leave_link
        return
    fi

    if [[ -n "$(lan_v4)" ]]; then
        if lease_alive; then
            enter_lan
            return
        fi
        log "dropping stale ${IFACE} address $(lan_v4 | tr '\n' ' ')"
        stop_dhcp
        ip addr flush dev "${IFACE}" scope global || true
    elif has_direct; then
        enter_direct
        return
    fi

    try_dhcp
    if [[ -n "$(lan_v4)" ]]; then
        enter_lan
        return
    fi

    stop_dhcp
    ip addr flush dev "${IFACE}" scope global || true
    enter_direct
}

do_configure() {
    need_cfg=1
    if [[ "${busy:-0}" -eq 1 ]]; then
        return
    fi
    busy=1
    while [[ "${need_cfg}" -eq 1 ]]; do
        need_cfg=0
        configure_locked
    done
    busy=0
}

wait_carrier() {
    local deadline=$((SECONDS + CARRIER_WAIT))
    while (( SECONDS < deadline )); do
        has_carrier && return 0
        sleep 1
    done
    return 1
}

do_start() {
    if watch_pid; then
        kick_watch
        return 0
    fi
    ip link show "${IFACE}" &>/dev/null || {
        log "no ${IFACE}, skipping"
        return 0
    }
    ip link set dev "${IFACE}" up || true
    wait_carrier || {
        log "no carrier on ${IFACE}"
        return 0
    }
    do_configure
}

do_watch() {
    exec 9>"${LOCKFILE}"
    if ! flock -n 9; then
        log "already running"
        exit 0
    fi
    echo $$ > "${PIDFILE}"
    trap 'rm -f "${PIDFILE}"; stop_addr_mon; leave_link; exit 0' EXIT
    trap 'exit 0' TERM INT
    trap 'do_configure' USR1

    local prev="init" cur now
    local last_empty_retry=0 last_dhcp_retry=0
    while true; do
        if ! iface_exists; then
            if [[ "${prev}" != "gone" ]]; then
                log "no ${IFACE}"
                leave_link
                prev="gone"
            fi
            stop_addr_mon
            sleep 2
            continue
        fi
        if ! addr_mon_alive; then
            start_addr_mon
            # The socket was down, so an address may have changed unobserved.
            refresh_addr_cache
        fi
        ensure_up
        if has_carrier; then
            cur="up"
        else
            cur="down"
        fi
        if [[ "${cur}" != "${prev}" ]]; then
            if [[ "${cur}" == "up" ]]; then
                # PHY can report carrier before frames flow.
                sleep 1
                do_configure
            else
                log "carrier lost on ${IFACE}"
                leave_link
            fi
            prev="${cur}"
        elif [[ "${cur}" == "up" ]]; then
            now=$SECONDS
            if drain_addr_events; then
                refresh_addr_cache
            fi
            if [[ "${addr_cache}" == empty ]]; then
                if (( now - last_empty_retry >= 5 )); then
                    last_empty_retry=$now
                    refresh_addr_cache
                    if [[ "${addr_cache}" == empty ]]; then
                        log "carrier up on ${IFACE} with no IPv4 address; reconfiguring"
                        do_configure
                    fi
                fi
            elif [[ "${addr_cache}" == lan ]] && ! dhcp_client_running; then
                if (( now - last_dhcp_retry >= 15 )); then
                    last_dhcp_retry=$now
                    log "DHCP client on ${IFACE} not running; restarting"
                    try_dhcp
                    refresh_addr_cache
                fi
            fi
        fi
        sleep 1
    done
}

case "${1:-start}" in
    stop|down) leave_link ;;
    start|up|"") do_start ;;
    watch) do_watch ;;
    *) echo "usage: $0 [start|stop|watch]" >&2; exit 1 ;;
esac
