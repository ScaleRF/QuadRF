#!/bin/bash
# wlan0 client, fallback AP, or off. Boot uses "start" (honours the last
# user mode). The GUI calls sta/ap/off for a live switch; those persist
# QUADRF_WIFI_MODE. Fallback AP after a failed client join does not.
# sta with no saved network persists ap so the Client toggle is not left on.
set -euo pipefail

. /usr/share/quadrf/functions.sh
quadrf_load_conf

AP_CONF=/etc/dnsmasq.d/quadrf-wlan0-ap.conf
LAN_CONF=/etc/dnsmasq.d/quadrf-wlan0-lan.conf
CONFIG_TXT="${QUADRF_BOOT_DIR}/config.txt"
STA_TIMEOUT=12
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant.conf
LOCKFILE=/run/quadrf-hotspot.lock
CAPTIVE_DNS_PID=/run/quadrf-captive-dns.pid
CAPTIVE_DNS_PORT=10053

log() { logger -t quadrf-hotspot -- "$*"; echo "$*"; }

restart_dnsmasq() {
    # SIGHUP does not reread snippets in /etc/dnsmasq.d. Do not make a
    # network-startup hook wait for the full service restart.
    systemctl restart --no-block dnsmasq.service 2>/dev/null || true
}

wifi_disabled() {
    [[ -f "${CONFIG_TXT}" ]] &&
        grep -qE '^[[:space:]]*#?[[:space:]]*dtoverlay=disable-wifi' "${CONFIG_TXT}"
}

wifi_mode() {
    case "${QUADRF_WIFI_MODE:-sta}" in
        ap|off|sta) printf '%s\n' "${QUADRF_WIFI_MODE:-sta}" ;;
        *) printf 'sta\n' ;;
    esac
}

wifi_fallback() {
    case "${QUADRF_WIFI_FALLBACK:-yes}" in
        no|NO|false|FALSE|0) return 1 ;;
        *) return 0 ;;
    esac
}

persist_mode() {
    quadrf_conf_set QUADRF_WIFI_MODE "$1"
    QUADRF_WIFI_MODE="$1"
}

ap_slash24() {
    printf '%s\n' "${QUADRF_AP_ADDRESS%.*}"
}

# Address from our own AP dhcpd, not from the saved client network.
on_ap_subnet() {
    local addr="$1"
    [[ "${addr%.*}" == "$(ap_slash24)" ]]
}

wlan_sta_addr() {
    ip -4 -o addr show dev wlan0 scope global 2>/dev/null | while read -r _ _ _ cidr _; do
        addr="${cidr%%/*}"
        on_ap_subnet "${addr}" && continue
        printf '%s\n' "${addr}"
        return 0
    done
}

drop_ap_subnet_sta() {
    local ap24 cidr addr
    ap24="$(ap_slash24)"
    ip -4 -o addr show dev wlan0 scope global 2>/dev/null | while read -r _ _ _ cidr _; do
        addr="${cidr%%/*}"
        [[ "${addr}" == "${QUADRF_AP_ADDRESS}" ]] && continue
        [[ "${addr%.*}" == "${ap24}" ]] || continue
        ip addr del "${cidr}" dev wlan0 2>/dev/null || true
    done
}

# Cached 192.168.44.x from our dhcpd is renewed before DISCOVER on the LAN.
purge_wlan_dhclient_leases() {
    rm -f /var/lib/dhcp/dhclient.wlan0.leases
    local f=/var/lib/dhcp/dhclient.leases
    [[ -f "${f}" ]] || return 0
    local tmp
    tmp="$(mktemp)"
    awk '
        /^lease \{/ { buf = $0 ORS; inlease = 1; skip = 0; next }
        inlease {
            buf = buf $0 ORS
            if ($0 ~ /interface "wlan0"/) skip = 1
            if ($0 ~ /^}/) {
                if (!skip) printf "%s", buf
                inlease = 0
            }
            next
        }
        { print }
    ' "${f}" > "${tmp}"
    cat "${tmp}" > "${f}"
    rm -f "${tmp}"
}

sta_ready() {
    iw dev wlan0 link 2>/dev/null | grep -q 'Connected to' &&
        [[ -n "$(wlan_sta_addr)" ]]
}

has_saved_network() {
    [[ -f "${WPA_CONF}" ]] && grep -qE '^[[:space:]]*network=' "${WPA_CONF}"
}

# GUI (QUADRF_USER) reads the SSID in Network Setup; DietPi ships this 600 root.
readable_wpa() {
    [[ -f "${WPA_CONF}" ]] || return 0
    chown root:"${QUADRF_USER}" "${WPA_CONF}" 2>/dev/null || true
    chmod 640 "${WPA_CONF}" 2>/dev/null || true
}

# ifup dhcp on wlan0 against our own AP rewrites resolv.conf to 192.168.44.1.
restore_lan_dns() {
    grep -q "nameserver ${QUADRF_AP_ADDRESS}" /etc/resolv.conf 2>/dev/null || return 0
    dns=""
    if [[ -f /var/lib/dhcp/dhclient.eth0.leases ]]; then
        dns="$(awk '/option domain-name-servers/ { gsub(/;/, "", $3); print $3; exit }' \
            /var/lib/dhcp/dhclient.eth0.leases)"
    fi
    [[ -n "${dns}" ]] || dns="1.1.1.1"
    printf 'nameserver %s\n' "${dns}" > /etc/resolv.conf
    log "restored resolver ${dns} after AP bring-up"
}

stop_sta() {
    systemctl stop wpa_supplicant 2>/dev/null || true
    pkill -f 'wpa_supplicant.*wlan0' 2>/dev/null || true
    if command -v dhclient >/dev/null; then
        timeout 2 dhclient -r wlan0 >/dev/null 2>&1 || true
        pkill -f 'dhclient.*wlan0' 2>/dev/null || true
    fi
}

stop_captive_dns() {
    if [[ -f "${CAPTIVE_DNS_PID}" ]]; then
        kill "$(cat "${CAPTIVE_DNS_PID}")" 2>/dev/null || true
        rm -f "${CAPTIVE_DNS_PID}"
    fi
    pkill -f -- '--pid-file=/run/quadrf-captive-dns.pid' 2>/dev/null || true
    nft_bin="$(command -v nft 2>/dev/null || true)"
    [[ -z "${nft_bin}" && -x /usr/sbin/nft ]] && nft_bin=/usr/sbin/nft
    if [[ -n "${nft_bin}" ]]; then
        "${nft_bin}" delete table ip quadrf_captive 2>/dev/null || true
    else
        iptables -t nat -D PREROUTING -i wlan0 -p udp --dport 53 \
            -m comment --comment quadrf-captive-dns -j REDIRECT \
            --to-ports "${CAPTIVE_DNS_PORT}" 2>/dev/null || true
        iptables -t nat -D PREROUTING -i wlan0 -p tcp --dport 53 \
            -m comment --comment quadrf-captive-dns -j REDIRECT \
            --to-ports "${CAPTIVE_DNS_PORT}" 2>/dev/null || true
    fi
}

# Wildcard DNS for AP clients only. address=/#/ in the shared dnsmasq is
# global and would steal names on eth0/usb0 (apt, etc.) while the AP is up.
start_captive_dns() {
    stop_captive_dns
    nft_bin="$(command -v nft 2>/dev/null || true)"
    [[ -z "${nft_bin}" && -x /usr/sbin/nft ]] && nft_bin=/usr/sbin/nft

    dnsmasq --conf-file=/dev/null \
        --pid-file="${CAPTIVE_DNS_PID}" \
        --dhcp-leasefile=/run/quadrf-captive-dns.leases \
        --listen-address="${QUADRF_AP_ADDRESS}" \
        --port="${CAPTIVE_DNS_PORT}" \
        --bind-interfaces \
        --no-resolv --no-hosts \
        --address="/#/${QUADRF_AP_ADDRESS}" \
        --except-interface=lo \
        --user=dnsmasq || {
        log "captive DNS failed to start"
        return 0
    }
    if [[ -n "${nft_bin}" ]]; then
        "${nft_bin}" -f - <<EOF || log "captive DNS nft rules failed"
table ip quadrf_captive {
    chain prerouting {
        type nat hook prerouting priority dstnat;
        iifname "wlan0" udp dport 53 redirect to :${CAPTIVE_DNS_PORT}
        iifname "wlan0" tcp dport 53 redirect to :${CAPTIVE_DNS_PORT}
    }
}
EOF
    else
        log "nftables not installed, AP clients will not hit captive DNS"
    fi
}

stop_ap() {
    stop_captive_dns
    systemctl stop hostapd.service 2>/dev/null || true
    systemctl stop isc-dhcp-server.service 2>/dev/null || true
    # dhcpd can still ACK a wlan0 DISCOVER during stop; that lease is
    # 192.168.44.x and looks like a successful client join.
    pkill -x dhcpd 2>/dev/null || true
    rm -f /run/dhcp-server/dhcpd.pid /var/run/dhcpd.pid
    if [[ -f "${AP_CONF}" ]]; then
        rm -f "${AP_CONF}"
        restart_dnsmasq
    fi
}

radio_down() {
    stop_ap
    stop_sta
    ip addr flush dev wlan0 2>/dev/null || true
    rm -f "${LAN_CONF}" "${AP_CONF}"
    ip link set dev wlan0 down 2>/dev/null || true
}

ensure_wlan() {
    if wifi_disabled; then
        log "dtoverlay=disable-wifi is set in ${CONFIG_TXT}; wlan0 is unavailable"
        return 1
    fi
    if ! ip link show wlan0 &>/dev/null; then
        log "no wlan0 interface"
        return 1
    fi
    return 0
}

# brcmfmac wants a down/up when leaving AP mode.
radio_reset() {
    ip link set dev wlan0 down || true
    stop_sta
    ip addr flush dev wlan0 2>/dev/null || true
    ip link set dev wlan0 up || true
}

# Drop a dhclient lease on our own AP (wlan0=192.168.44.12) so mDNS never
# advertises a client address as the appliance.
wlan_only_ap_addr() {
    ip -4 -o addr show dev wlan0 scope global 2>/dev/null | while read -r _ _ _ cidr _; do
        addr="${cidr%%/*}"
        [[ "${addr}" == "${QUADRF_AP_ADDRESS}" ]] && continue
        ip addr del "${cidr}" dev wlan0 2>/dev/null || true
    done
}

keep_sta() {
    log "wlan0 associated, staying in client mode"
    if [[ -f "${AP_CONF}" ]]; then
        rm -f "${AP_CONF}"
        restart_dnsmasq || true
    fi
    if [[ -x /usr/sbin/quadrf-dns-update ]]; then
        /usr/sbin/quadrf-dns-update || true
    fi
}

try_station() {
    stop_ap
    radio_reset
    drop_ap_subnet_sta
    purge_wlan_dhclient_leases
    if ! has_saved_network; then
        log "no saved client network"
        return 1
    fi
    # Do not let the daemon inherit the flock fd; it would hold the lock forever.
    wpa_supplicant -B -i wlan0 -c "${WPA_CONF}" 9>&- >/dev/null 2>&1 || true
    local deadline=$((SECONDS + STA_TIMEOUT))
    while (( SECONDS < deadline )); do
        drop_ap_subnet_sta
        if iw dev wlan0 link 2>/dev/null | grep -q 'Connected to' &&
           [[ -z "$(wlan_sta_addr)" ]]; then
            timeout 8 dhclient -1 wlan0 9>&- >/dev/null 2>&1 || true
            drop_ap_subnet_sta
        fi
        sta_ready && return 0
        sleep 1
    done
    drop_ap_subnet_sta
    sta_ready
}

start_ap() {
    stop_sta
    radio_reset
    rm -f "${LAN_CONF}"
    iw dev wlan0 set power_save off 2>/dev/null || true
    ip addr add "${QUADRF_AP_ADDRESS}/24" dev wlan0 2>/dev/null || true
    wlan_only_ap_addr
    sleep 2

    # Names for AP clients. Do not use address=/#/... — that is global in
    # dnsmasq and hijacks DNS on eth0/usb0 (apt, etc.) while the AP is up.
    cat > "${AP_CONF}" <<EOF
interface=wlan0
no-dhcp-interface=wlan0
interface-name=${QUADRF_HOSTNAME}.local,wlan0
interface-name=${QUADRF_HOSTNAME},wlan0
interface-name=$(quadrf_desktop_mdns),wlan0
interface-name=$(quadrf_desktop_mdns_short),wlan0
EOF

    systemctl unmask hostapd.service 2>/dev/null || true
    if ! systemctl start hostapd.service ||
       ! systemctl is-active --quiet hostapd.service; then
        log "hostapd failed to start, see journalctl -u hostapd"
        return 1
    fi

    rm -f /run/dhcp-server/dhcpd.pid /var/run/dhcpd.pid
    systemctl start isc-dhcp-server || log "isc-dhcp-server failed, clients will not get leases"
    restart_dnsmasq || log "dnsmasq restart request failed"
    start_captive_dns
    restore_lan_dns
    wlan_only_ap_addr
    log "access point up: SSID ${QUADRF_AP_SSID} on ${QUADRF_AP_ADDRESS}"
}

apply_sta() {
    if ! has_saved_network; then
        log "no saved client network"
        if wifi_fallback; then
            persist_mode ap
            start_ap
        else
            log "AP fallback disabled, leaving wlan0 down"
            radio_down
        fi
        return 0
    fi
    if try_station; then
        keep_sta
        return 0
    fi
    if wifi_fallback; then
        log "no wlan0 association after ${STA_TIMEOUT}s, starting ${QUADRF_AP_SSID} access point"
        start_ap
        return 0
    fi
    log "no wlan0 association after ${STA_TIMEOUT}s, AP fallback disabled"
    return 0
}

cmd_start() {
    readable_wpa
    if wifi_disabled; then
        log "dtoverlay=disable-wifi is set in ${CONFIG_TXT}; wlan0 is unavailable"
        return 1
    fi
    if ! ip link show wlan0 &>/dev/null; then
        log "no wlan0 interface, skipping"
        return 0
    fi
    case "$(wifi_mode)" in
        off)
            log "QUADRF_WIFI_MODE=off, leaving wlan0 down"
            radio_down
            ;;
        ap)
            start_ap
            ;;
        *)
            apply_sta
            ;;
    esac
}

cmd_sta() {
    readable_wpa
    ensure_wlan || return 1
    persist_mode sta
    apply_sta
}

cmd_ap() {
    ensure_wlan || return 1
    persist_mode ap
    start_ap
}

cmd_off() {
    persist_mode off
    if ip link show wlan0 &>/dev/null; then
        radio_down
    fi
    log "wlan0 off"
}

cmd_fallback() {
    case "${1:-}" in
        yes|no) ;;
        *) echo "usage: $0 fallback yes|no" >&2; return 1 ;;
    esac
    quadrf_conf_set QUADRF_WIFI_FALLBACK "$1"
    log "QUADRF_WIFI_FALLBACK=$1"
}

cmd="${1:-start}"
exec 9>"${LOCKFILE}"
flock 9

case "${cmd}" in
    start|"") cmd_start ;;
    sta) cmd_sta ;;
    ap) cmd_ap ;;
    off) cmd_off ;;
    fallback) cmd_fallback "${2:-}" ;;
    *) echo "usage: $0 [start|sta|ap|off|fallback yes|no]" >&2; exit 1 ;;
esac
