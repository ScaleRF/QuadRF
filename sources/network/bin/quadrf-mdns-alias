#!/usr/bin/python3
# Advertise HOSTNAME.local, HOSTNAME-desktop.local and HOSTNAMEd.local with
# each A record bound to the interface that owns the address.
# avahi-daemon's own host records have no ifindex, so nss-mdns on the LAN
# would pick the AP address (192.168.44.1) and fail. 40-network turns
# publish-addresses off; this process is the only publisher.
# A two-label name like desktop.HOSTNAME.local is ignored by browser mDNS.
#
# One EntryGroup per interface so a LAN collision does not withdraw
# direct-connect records. On COLLISION, unless QUADRF_HOSTNAME_LOCK is set,
# persist HOSTNAME-2 via quadrf-apply-hostname and re-apply site config.

import os
import socket
import subprocess
import sys
import time

try:
    import avahi
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
except ImportError as exc:
    print(f"quadrf-mdns-alias: missing dependency ({exc})", file=sys.stderr)
    sys.exit(1)

CONF = os.environ.get("QUADRF_CONF", "/etc/quadrf/quadrf.conf")
HELPER = os.environ.get("QUADRF_APPLY_HOSTNAME", "/usr/sbin/quadrf-apply-hostname")
POLL_SEC = 2
JOINER_GRACE_SEC = 45
AP_DEFAULT = "192.168.44.1"
MAX_ALT = 99


def load_conf():
    hostname = "quadrf"
    ap_addr = AP_DEFAULT
    locked = False
    try:
        with open(CONF, encoding="utf-8") as fh:
            for raw in fh:
                line = raw.split("#", 1)[0].strip()
                if line.startswith("QUADRF_HOSTNAME="):
                    hostname = line.split("=", 1)[1].strip().strip("'\"") or hostname
                elif line.startswith("QUADRF_AP_ADDRESS="):
                    ap_addr = line.split("=", 1)[1].strip().strip("'\"") or ap_addr
                elif line.startswith("QUADRF_HOSTNAME_LOCK="):
                    val = line.split("=", 1)[1].strip().strip("'\"").lower()
                    locked = val in ("yes", "true", "1")
    except OSError:
        pass
    return hostname, ap_addr, locked


def _slash24(addr):
    parts = addr.split(".")
    if len(parts) != 4:
        return ""
    return ".".join(parts[:3])


def alias_names(hostname):
    return [
        f"{hostname}.local",
        f"{hostname}-desktop.local",
        f"{hostname}d.local",
    ]


def alternative_hostname(name):
    # avahi_alternative_host_name: trailing -N increments, else append -2.
    i = name.rfind("-")
    if i > 0 and name[i + 1 :].isdigit():
        n = int(name[i + 1 :]) + 1
        if n > MAX_ALT:
            return None
        return f"{name[:i]}-{n}"
    return f"{name}-2"


def keep_addr(iface, addr, ap_addr, ap_up=True):
    # Link-local and loopback are not a path. A dhclient lease from our
    # own dhcpd (wlan0=.12 while the AP is up) is not a LAN path either.
    if addr.startswith("127.") or addr.startswith("169.254."):
        return False
    if iface.startswith("tun") or iface.startswith("tap"):
        return False
    if (
        ap_up
        and iface == "wlan0"
        and addr != ap_addr
        and _slash24(addr) == _slash24(ap_addr)
    ):
        return False
    return True


def iface_addrs(ap_addr):
    """Global IPv4 addresses keyed to the interface that owns them."""
    try:
        out = subprocess.check_output(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return []
    parsed = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 4 or parts[2] != "inet":
            continue
        iface = parts[1]
        addr = parts[3].split("/", 1)[0]
        parsed.append((iface, addr))
    ap_up = any(iface == "wlan0" and addr == ap_addr for iface, addr in parsed)
    
    by_iface = {}
    for iface, addr in parsed:
        if not keep_addr(iface, addr, ap_addr, ap_up):
            continue
        by_iface.setdefault(iface, []).append(addr)

    pairs = []
    for iface, addrs in by_iface.items():
        if len(addrs) > 1 and any(not a.startswith("10.55.") for a in addrs):
            addrs = [a for a in addrs if not a.startswith("10.55.")]
        for addr in addrs:
            try:
                idx = socket.if_nametoindex(iface)
            except OSError:
                continue
            if idx <= 0:
                continue
            pairs.append((idx, iface, addr))
    pairs.sort(key=lambda p: (p[1], p[2]))
    return pairs


def local_macs():
    macs = set()
    net_dir = "/sys/class/net"
    try:
        entries = os.listdir(net_dir)
    except OSError:
        return macs
    for iface in entries:
        if iface == "lo" or iface.startswith("tun") or iface.startswith("tap"):
            continue
        try:
            with open(os.path.join(net_dir, iface, "address"), encoding="ascii") as fh:
                mac = fh.read().strip().lower()
                if mac and mac != "00:00:00:00:00:00" and len(mac) == 17:
                    macs.add(mac)
        except OSError:
            pass
    return macs


def parse_txt_macs(raw_txt):
    try:
        txt_list = avahi.txt_array_to_string_array(raw_txt)
    except Exception:
        return set()
    macs = set()
    for item in txt_list:
        if isinstance(item, bytes):
            item = item.decode("utf-8", "replace")
        if item.startswith("macs="):
            for m in item[5:].split(","):
                m = m.strip().lower()
                if m:
                    macs.add(m)
    return macs


def parse_txt_str_macs(txt_str):
    macs = set()
    for token in txt_str.split('"'):
        token = token.strip()
        if token.startswith("macs="):
            for m in token[5:].split(","):
                m = m.strip().lower()
                if m:
                    macs.add(m)
    return macs


def is_foreign_peer_alive(addr, my_macs):
    # Elicit an ARP response if the neighbor entry is absent
    try:
        subprocess.run(
            ["ping", "-n", "-c", "1", "-W", "1", addr],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1.5,
        )
    except (OSError, subprocess.SubprocessError):
        pass

    try:
        out = subprocess.check_output(
            ["ip", "-4", "neigh", "show", "to", addr],
            text=True,
            timeout=1,
        )
        for line in out.splitlines():
            parts = line.split()
            if "lladdr" in parts:
                idx = parts.index("lladdr")
                if idx + 1 < len(parts):
                    mac = parts[idx + 1].strip().lower()
                    if mac in my_macs:
                        return False
            if any(state in parts for state in ("REACHABLE", "DELAY", "PERMANENT")):
                return True
    except (OSError, subprocess.SubprocessError):
        pass
    return False


def resolve_name_ip(name):
    try:
        out = subprocess.check_output(
            ["avahi-resolve", "-n", name],
            text=True,
            timeout=2,
        )
        for line in out.splitlines():
            parts = line.strip().split()
            if len(parts) >= 2 and parts[0] == name:
                return parts[1]
    except (OSError, subprocess.SubprocessError):
        pass
    return None


class Publisher:
    def __init__(self):
        self.base = "quadrf"
        self.ap_addr = AP_DEFAULT
        self.locked = False
        self._renaming = None
        self.started = time.monotonic()
        self.bus = dbus.SystemBus()
        self.server = None
        self.slots = {}
        self.browsers = []
        self._avahi_gone = False
        self._busy = False
        self._again = False
        dbus.Interface(
            self.bus.get_object(dbus.BUS_DAEMON_NAME, dbus.BUS_DAEMON_PATH),
            dbus.BUS_DAEMON_IFACE,
        ).connect_to_signal("NameOwnerChanged", self._name_owner)
        self.attach()

    def _name_owner(self, name, _old, new):
        if name != avahi.DBUS_NAME:
            return
        if new:
            self.attach()
            self.publish()
        else:
            self.drop_group()
            self.server = None

    def attach(self):
        self.drop_group()
        try:
            self.server = dbus.Interface(
                self.bus.get_object(avahi.DBUS_NAME, avahi.DBUS_PATH_SERVER),
                avahi.DBUS_INTERFACE_SERVER,
            )
            self._avahi_gone = False
            self._watch_peers()
            return True
        except dbus.DBusException as exc:
            self.server = None
            if not self._avahi_gone:
                print(f"quadrf-mdns-alias: avahi unavailable ({exc})",
                      file=sys.stderr, flush=True)
                self._avahi_gone = True
            return False

    def drop_group(self):
        for idx in list(self.slots):
            self._drop_slot(idx)

    def _drop_slot(self, idx):
        slot = self.slots.pop(idx, None)
        if slot is None or slot["group"] is None:
            return
        try:
            slot["group"].Reset()
        except dbus.DBusException:
            pass

    def _group_for(self, idx, slot):
        if slot["group"] is None:
            path = self.server.EntryGroupNew()
            group = dbus.Interface(
                self.bus.get_object(avahi.DBUS_NAME, path),
                avahi.DBUS_INTERFACE_ENTRY_GROUP,
            )
            group.connect_to_signal(
                "StateChanged",
                lambda state, error, i=idx: self._group_state(i, state, error),
            )
            slot["group"] = group
        return slot["group"]

    def _is_renaming(self):
        if not self._renaming:
            return False
        if time.monotonic() - getattr(self, "_renaming_at", 0) > 30:
            print(f"quadrf-mdns-alias: rename to {self._renaming} timed out",
                  file=sys.stderr, flush=True)
            self._renaming = None
            return False
        return True

    def _spawn_rename(self, nxt):
        if self._is_renaming():
            return
        self._renaming = nxt
        self._renaming_at = time.monotonic()
        print(f"quadrf-mdns-alias: {self.base}.local taken, applying {nxt}.local",
              flush=True)
        try:
            subprocess.Popen(
                [HELPER, "rename", nxt],
                stdin=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )
        except OSError as exc:
            self._renaming = None
            print(f"quadrf-mdns-alias: rename failed ({exc})",
                  file=sys.stderr, flush=True)

    def _group_state(self, idx, state, error):
        slot = self.slots.get(idx)
        if slot is None:
            return
        state = int(state)
        if state == avahi.ENTRY_GROUP_ESTABLISHED:
            slot["ok"] = True
            slot["conflict"] = None
            return
        if state == avahi.ENTRY_GROUP_FAILURE:
            print(f"quadrf-mdns-alias: {slot['iface']} group failed ({error})",
                  file=sys.stderr, flush=True)
            slot["ok"] = False
            slot["key"] = None
            return
        if state != avahi.ENTRY_GROUP_COLLISION:
            return
        slot["ok"] = False
        slot["key"] = None
        if self.locked:
            slot["conflict"] = (idx, slot.get("addr"))
            print(f"quadrf-mdns-alias: {slot['iface']} collision on "
                  f"{self.base}.local, locked", flush=True)
            return
        if self._is_renaming():
            return

        our = {a for _, _, a in iface_addrs(self.ap_addr)}
        resolved_ip = resolve_name_ip(f"{self.base}.local")
        if resolved_ip and resolved_ip in our:
            print(f"quadrf-mdns-alias: {slot['iface']} collision on {self.base}.local "
                  f"resolves to local IP {resolved_ip}, ignoring", flush=True)
            return
        my_macs = local_macs()
        if resolved_ip and not is_foreign_peer_alive(resolved_ip, my_macs):
            print(f"quadrf-mdns-alias: {slot['iface']} collision on {self.base}.local "
                  f"peer at {resolved_ip} not active on L2, ignoring", flush=True)
            return

        nxt = alternative_hostname(self.base)
        if nxt is None:
            print(f"quadrf-mdns-alias: {slot['iface']} collision, "
                  f"no names left after {self.base}.local",
                  file=sys.stderr, flush=True)
            return
        self._spawn_rename(nxt)

    def _watch_peers(self):
        self.browsers = []
        if self.server is None:
            return
        for stype in ("_quadrf._tcp",):
            try:
                path = self.server.ServiceBrowserNew(
                    avahi.IF_UNSPEC,
                    avahi.PROTO_UNSPEC,
                    stype,
                    "local",
                    dbus.UInt32(0),
                )
                browser = dbus.Interface(
                    self.bus.get_object(avahi.DBUS_NAME, path),
                    avahi.DBUS_INTERFACE_SERVICE_BROWSER,
                )
                browser.connect_to_signal("ItemNew", self._peer_new)
                self.browsers.append(browser)
            except dbus.DBusException as exc:
                print(f"quadrf-mdns-alias: peer watch {stype} failed ({exc})",
                      file=sys.stderr, flush=True)

    def _peer_new(self, iface, proto, name, stype, domain, flags):
        own = int(getattr(avahi, "LOOKUP_RESULT_OUR_OWN", 16))
        if int(flags) & own:
            return
        try:
            self.server.ResolveService(
                iface, proto, name, stype, domain,
                avahi.PROTO_INET, dbus.UInt32(0),
                reply_handler=self._peer_resolved,
                error_handler=lambda *_a: None,
            )
        except dbus.DBusException:
            pass

    def _peer_resolved(self, _iface, _proto, _name, _stype, _domain, host,
                       _aproto, addr, _port, _txt, flags):
        own = int(getattr(avahi, "LOOKUP_RESULT_OUR_OWN", 16))
        if int(flags) & own:
            return
        host = str(host).rstrip(".").lower()
        addr = str(addr)
        if host != f"{self.base}.local":
            return
        our = {a for _, _, a in iface_addrs(self.ap_addr)}
        if not our or addr in our:
            return
        my_macs = local_macs()
        peer_macs = parse_txt_macs(_txt)
        if peer_macs & my_macs:
            return
        if not is_foreign_peer_alive(addr, my_macs):
            return
        if self.locked or self._is_renaming():
            return
        nxt = alternative_hostname(self.base)
        if nxt is None:
            return
        print(f"quadrf-mdns-alias: {host} also at {addr}, applying {nxt}.local",
              flush=True)
        self._spawn_rename(nxt)

    def _probe_peers(self):
        if self.locked or self._is_renaming():
            return True
        if time.monotonic() - self.started > JOINER_GRACE_SEC:
            return True
        try:
            proc = subprocess.run(
                ["avahi-browse", "-lrktp", "_quadrf._tcp"],
                capture_output=True, text=True, timeout=3,
            )
            out = proc.stdout or ""
        except subprocess.TimeoutExpired as exc:
            out = exc.stdout or ""
            if isinstance(out, bytes):
                out = out.decode("utf-8", "replace")
        except OSError:
            return True
        our = {a for _, _, a in iface_addrs(self.ap_addr)}
        if not our:
            return True
        my_macs = local_macs()
        want = f"{self.base}.local"
        for line in out.splitlines():
            parts = line.strip().split(";")
            if len(parts) < 8 or parts[0] != "=":
                continue
            host = parts[6].rstrip(".").lower()
            addr = parts[7].strip()
            txt_str = parts[9] if len(parts) > 9 else ""
            if host == want and addr not in our:
                peer_macs = parse_txt_str_macs(txt_str)
                if peer_macs & my_macs:
                    continue
                if not is_foreign_peer_alive(addr, my_macs):
                    continue
                nxt = alternative_hostname(self.base)
                if nxt:
                    print(f"quadrf-mdns-alias: {host} also at {addr}, "
                          f"applying {nxt}.local", flush=True)
                    self._spawn_rename(nxt)
                return True
        return True

    def _publish_iface(self, idx, iface, addr):
        slot = self.slots.get(idx)
        if slot is None:
            slot = {
                "iface": iface,
                "addr": addr,
                "group": None,
                "key": None,
                "ok": False,
                "conflict": None,
            }
            self.slots[idx] = slot
        else:
            slot["iface"] = iface
            slot["addr"] = addr

        key = (idx, addr)
        if key == slot["key"] or key == slot["conflict"]:
            return

        names = alias_names(self.base)
        my_macs = local_macs()
        txt = (
            avahi.string_array_to_txt_array([f"macs={','.join(sorted(my_macs))}"])
            if my_macs
            else []
        )
        try:
            group = self._group_for(idx, slot)
            if not group.IsEmpty():
                group.Reset()
            flags = dbus.UInt32(avahi.PUBLISH_NO_REVERSE)
            svc_flags = dbus.UInt32(0)
            for name in names:
                group.AddAddress(
                    dbus.Int32(idx),
                    dbus.Int32(avahi.PROTO_INET),
                    flags,
                    name,
                    addr,
                )
            group.AddService(
                dbus.Int32(idx),
                dbus.Int32(avahi.PROTO_INET),
                svc_flags,
                self.base,
                "_quadrf._tcp",
                "local",
                f"{self.base}.local",
                dbus.UInt16(80),
                txt,
            )
            group.Commit()
        except dbus.DBusException as exc:
            print(f"quadrf-mdns-alias: {iface} publish failed ({exc})",
                  file=sys.stderr, flush=True)
            self._drop_slot(idx)
            return

        print(f"quadrf-mdns-alias: {iface}={addr} -> {' '.join(names)}",
              flush=True)
        slot["key"] = key

    def publish(self):
        if self._busy:
            self._again = True
            return True
        self._busy = True
        try:
            self._publish()
            while self._again:
                self._again = False
                self._publish()
        finally:
            self._busy = False
        return True

    def _publish(self):
        hostname, ap_addr, locked = load_conf()
        self.ap_addr = ap_addr
        if self.locked and not locked:
            for slot in self.slots.values():
                slot["conflict"] = None
        self.locked = locked
        if self._renaming and hostname == self._renaming:
            print(f"quadrf-mdns-alias: now {hostname}.local", flush=True)
            self._renaming = None
            self.drop_group()
        if hostname != self.base:
            self.base = hostname
            self.drop_group()
        if self._is_renaming():
            return

        if self.server is None and not self.attach():
            return
        try:
            if int(self.server.GetState()) != avahi.SERVER_RUNNING:
                return
        except dbus.DBusException:
            self.attach()
            return

        pairs = iface_addrs(self.ap_addr)
        live = {idx for idx, _, _ in pairs}
        for idx in list(self.slots):
            if idx not in live:
                self._drop_slot(idx)
        if not pairs:
            print("quadrf-mdns-alias: no IPv4 addresses yet", flush=True)
            return
        for idx, iface, addr in pairs:
            self._publish_iface(idx, iface, addr)


def main():
    DBusGMainLoop(set_as_default=True)
    pub = Publisher()
    GLib.timeout_add_seconds(POLL_SEC, pub.publish)
    GLib.timeout_add_seconds(3, lambda: (pub._probe_peers(), False)[1])
    GLib.timeout_add_seconds(15, pub._probe_peers)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
