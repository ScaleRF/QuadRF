#!/bin/bash
# Publish the QuadRF names on wlan0 while it is a station on someone's LAN.
# Called from /etc/network/if-up.d/quadrf-dns and by quadrf-network on install.
set -euo pipefail

. /usr/share/quadrf/functions.sh
quadrf_load_conf

DEST=/etc/dnsmasq.d/quadrf-wlan0-lan.conf

restart_dnsmasq() {
    # SIGHUP does not reread dnsmasq configuration snippets. Queue the full
    # restart so if-up does not deadlock with network-online.target at boot.
    systemctl restart --no-block dnsmasq.service 2>/dev/null || true
}

if ! ip link show wlan0 &>/dev/null ||
   ! ip -4 -o addr show dev wlan0 scope global 2>/dev/null | grep -q .; then
    if [[ -f "${DEST}" ]]; then
        rm -f "${DEST}"
        restart_dnsmasq
    fi
    exit 0
fi

tmp="$(mktemp)"
cat > "${tmp}" <<EOF
# Generated by quadrf-dns-update
interface=wlan0
no-dhcp-interface=wlan0
interface-name=${QUADRF_TLS_DOMAIN},wlan0
interface-name=${QUADRF_HOSTNAME}.local,wlan0
interface-name=${QUADRF_HOSTNAME},wlan0
interface-name=$(quadrf_desktop_mdns),wlan0
interface-name=$(quadrf_desktop_mdns_short),wlan0
EOF

if [[ ! -f "${DEST}" ]] || ! cmp -s "${tmp}" "${DEST}"; then
    install -m 644 "${tmp}" "${DEST}"
    restart_dnsmasq
fi
rm -f "${tmp}"

systemctl try-restart quadrf-mdns.service 2>/dev/null || true
