#!/bin/bash
# Publish the QuadRF names on wlan0 while it is a station on someone's LAN.
# Called from /etc/network/if-up.d/quadrf-dns and by quadrf-network on install.
set -euo pipefail

. /usr/share/quadrf/functions.sh
quadrf_load_conf

DEST=/etc/dnsmasq.d/quadrf-wlan0-lan.conf

reload_dnsmasq() {
    # Do not block if-up on a dnsmasq start: at boot network.target waits for
    # ifup@wlan0 while dnsmasq waits for network-online.target, and a restart
    # here deadlocks the pair for about 45 seconds.
    if systemctl is-active --quiet dnsmasq.service; then
        systemctl reload dnsmasq.service 2>/dev/null ||
            systemctl try-restart dnsmasq.service &
    fi
}

if ! ip link show wlan0 &>/dev/null ||
   ! ip -4 -o addr show dev wlan0 scope global 2>/dev/null | grep -q .; then
    if [[ -f "${DEST}" ]]; then
        rm -f "${DEST}"
        reload_dnsmasq
    fi
    exit 0
fi

tmp="$(mktemp)"
cat > "${tmp}" <<EOF
# Generated by quadrf-dns-update
interface=wlan0
no-dhcp-interface=wlan0
interface-name=${QUADRF_TLS_DOMAIN},wlan0
interface-name=quadrf.local,wlan0
interface-name=quadrf,wlan0
EOF

if [[ ! -f "${DEST}" ]] || ! cmp -s "${tmp}" "${DEST}"; then
    install -m 644 "${tmp}" "${DEST}"
    reload_dnsmasq
fi
rm -f "${tmp}"
