# QuadRF front door. Generated from /usr/share/quadrf/network/nginx-site.in;
# edit the template or /etc/quadrf/quadrf.conf, then run "quadrf apply".
#
#   /                         control panel (Flask on 8080)
#   HOSTNAME-desktop.local    remote desktop (KasmVNC on 8444)
#   HOSTNAMEd.local           same desktop, short alias (quadrfd.local)
#   :6080                     same desktop, for IP access and as a fallback
#   /AR/                      browser AR overlay, static
#   /ws                       WebSocket from Spatial RF Vision on 8000
#
# KasmVNC's client assumes it is at the root of a host. Do not put it under
# a path prefix.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Unknown Host, including OS captive-portal probes on the access point.
# Do not return the Success / 204 bodies: those suppress the Sign In sheet.
# Apple wants 200 HTML here; Android/Windows follow the 302 to HOSTNAME.local.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/quadrf/captive;
    add_header Cache-Control "no-store";

    location = /generate_204 {
        return 302 http://@HOSTNAME@.local/;
    }

    location = /gen_204 {
        return 302 http://@HOSTNAME@.local/;
    }

    location = /connecttest.txt {
        return 302 http://@HOSTNAME@.local/;
    }

    location = /ncsi.txt {
        return 302 http://@HOSTNAME@.local/;
    }

    location = /success.txt {
        return 302 http://@HOSTNAME@.local/;
    }

    location / {
        try_files /index.html =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name @AP_ADDRESS@ @HOSTNAME@ @HOSTNAME@.local localhost;

    include snippets/quadrf-locations.conf;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name @AP_ADDRESS@ @HOSTNAME@ @HOSTNAME@.local localhost;

    ssl_certificate /etc/quadrf/tls/fullchain.pem;
    ssl_certificate_key /etc/quadrf/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    include snippets/quadrf-locations.conf;
}

server {
    listen 80;
    listen [::]:80;
    server_name @DESKTOP@ @DESKTOP_SHORT@ desktop.@HOSTNAME@.local;

    include snippets/quadrf-vnc.conf;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @DESKTOP@ @DESKTOP_SHORT@ desktop.@HOSTNAME@.local;

    ssl_certificate /etc/quadrf/tls/fullchain.pem;
    ssl_certificate_key /etc/quadrf/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    include snippets/quadrf-vnc.conf;
}

# Same KasmVNC root, reachable as http://<any-address>:6080/ when mDNS
# extra names are not available (raw IP, some phones).
server {
    listen 6080 default_server;
    listen [::]:6080 default_server;
    server_name _;

    include snippets/quadrf-vnc.conf;
}
