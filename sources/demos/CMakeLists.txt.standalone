cmake_minimum_required(VERSION 3.12)
project(QuadRF_Examples C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()

add_compile_options(-O3)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    add_compile_options(-mcpu=cortex-a76 -mtune=cortex-a76)
endif()

find_package(QuadRF REQUIRED)
find_package(PkgConfig REQUIRED)

add_executable(quadrf-hello hello.cpp)
target_link_libraries(quadrf-hello PRIVATE QuadRF::quadrf)

pkg_check_modules(FFTW3F REQUIRED fftw3f)
pkg_check_modules(SDL2 REQUIRED sdl2)

add_executable(quadrf-rf-vision csi_sweep.c mongoose.c)
target_link_libraries(quadrf-rf-vision PRIVATE QuadRF::quadrf ${FFTW3F_LIBRARIES} ${SDL2_LIBRARIES} m pthread)
target_include_directories(quadrf-rf-vision PRIVATE ${FFTW3F_INCLUDE_DIRS} ${SDL2_INCLUDE_DIRS})

add_executable(quadrf-psd psd_switchable.c)
target_link_libraries(quadrf-psd PRIVATE QuadRF::quadrf ${FFTW3F_LIBRARIES} ${SDL2_LIBRARIES} m)
target_include_directories(quadrf-psd PRIVATE ${FFTW3F_INCLUDE_DIRS} ${SDL2_INCLUDE_DIRS})

add_executable(quadrf-ntsc-demod ntsc_demod.cpp)
target_compile_options(quadrf-ntsc-demod PRIVATE -ffast-math)
target_link_libraries(quadrf-ntsc-demod PRIVATE QuadRF::quadrf)

add_executable(quadrf-nearfield nearfield.c)
target_link_libraries(quadrf-nearfield PRIVATE QuadRF::quadrf ${SDL2_LIBRARIES} m pthread)
target_include_directories(quadrf-nearfield PRIVATE ${SDL2_INCLUDE_DIRS})
