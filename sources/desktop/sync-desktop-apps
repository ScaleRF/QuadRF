#!/bin/sh
# Copy package-owned QuadRF app entries onto the operator's pcmanfm desktop.
set -eu

FUNCTIONS_PATH="${QUADRF_FUNCTIONS_PATH:-/usr/share/quadrf/functions.sh}"
. "${FUNCTIONS_PATH}"
quadrf_load_conf

APPLICATION_DIR="${QUADRF_APPLICATION_DIR:-/usr/share/applications}"

# Flow order for unfixed icons (mtime ascending). Do not write per-icon
# x/y: PCManFM then reflows on Kasm resize instead of clamping overflow
# onto the last row.
PREFERRED_DESKTOP_ENTRIES="quadrf-terminal.desktop quadrf-files.desktop quadrf-editor.desktop"
DESKTOP_MTIME_BASE=1000000000

if ! getent passwd "${QUADRF_USER}" >/dev/null; then
    echo "quadrf: user ${QUADRF_USER} does not exist, skipping app launchers" >&2
    exit 0
fi

HOME_DIR="$(getent passwd "${QUADRF_USER}" | cut -d: -f6)"
GROUP="$(id -gn "${QUADRF_USER}")"
DESKTOP_DIR="${QUADRF_DESKTOP_DIR:-${HOME_DIR}/Desktop}"
install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${DESKTOP_DIR}"

is_quadrf_entry() {
    case "$(basename "$1")" in
        quadrf-*.desktop) return 0 ;;
    esac
    grep -q '^X-QuadRF-Desktop=true$' "$1"
}

# Remove managed launchers left behind when an application package is
# uninstalled or withdraws its X-QuadRF-Desktop marker.
for dest in "${DESKTOP_DIR}"/*.desktop; do
    [ -f "${dest}" ] || continue
    is_quadrf_entry "${dest}" || continue
    entry="${APPLICATION_DIR}/$(basename "${dest}")"
    if [ ! -f "${entry}" ] || ! is_quadrf_entry "${entry}"; then
        rm -f "${dest}"
    fi
done

# Reverse-DNS desktop IDs with X-QuadRF-Desktop are preferred for independently
# packaged apps. Keep recognizing the old quadrf-* namespace for compatibility.
# Skip (and drop stale copies of) entries whose TryExec is missing; otherwise a
# double-click is "Invalid desktop entry file" rather than a hidden icon.
ORDER_TMP="$(mktemp)"
trap 'rm -f "${ORDER_TMP}"' EXIT HUP INT TERM

sync_desktop_entry() {
    entry="$1"
    dest="${DESKTOP_DIR}/$(basename "${entry}")"
    tryexec="$(sed -n 's/^TryExec=//p' "${entry}" | head -n1)"
    if [ -n "${tryexec}" ] && [ ! -x "${tryexec}" ] && ! command -v "${tryexec}" >/dev/null 2>&1; then
        rm -f "${dest}"
        return 0
    fi
    install -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${entry}" "${dest}"
    if command -v gio >/dev/null 2>&1; then
        runuser -u "${QUADRF_USER}" -- gio set "${dest}" metadata::trusted true 2>/dev/null || true
    fi
    printf '%s\n' "$(basename "${entry}")" >> "${ORDER_TMP}"
}

synced_entries=""
for name in ${PREFERRED_DESKTOP_ENTRIES}; do
    entry="${APPLICATION_DIR}/${name}"
    [ -f "${entry}" ] || continue
    is_quadrf_entry "${entry}" || continue
    sync_desktop_entry "${entry}"
    synced_entries="${synced_entries} ${name}"
done

for entry in "${APPLICATION_DIR}"/*.desktop; do
    [ -f "${entry}" ] || continue
    name="$(basename "${entry}")"
    case "${synced_entries}" in *" ${name}"*) continue ;; esac
    is_quadrf_entry "${entry}" || continue
    sync_desktop_entry "${entry}"
done

stamp_desktop_order() {
    [ -s "${ORDER_TMP}" ] || return 0
    n=0
    while IFS= read -r name; do
        [ -n "${name}" ] || continue
        dest="${DESKTOP_DIR}/${name}"
        [ -f "${dest}" ] || continue
        touch -d "@$((DESKTOP_MTIME_BASE + n))" "${dest}"
        n=$((n + 1))
    done < "${ORDER_TMP}"
}

# Wallpaper and sort only. Omitting per-icon groups drops fixed_pos so
# layout_items() wraps columns when the framebuffer changes.
write_desktop_layout() {
    profile_dir="${HOME_DIR}/.config/pcmanfm/LXDE"
    layout_file="${profile_dir}/desktop-items-0.conf"
    install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${profile_dir}"
    layout_tmp="$(mktemp)"
    cat > "${layout_tmp}" <<'EOF'
[*]
wallpaper=/usr/share/quadrf/desktop/wallpaper.png
wallpaper_mode=crop
wallpaper_common=1
desktop_bg=#2e3440
desktop_fg=#ffffff
desktop_shadow=#000000
desktop_font=Sans 12
show_wm_menu=0
sort=mtime;ascending;
show_documents=0
show_trash=0
show_mounts=0
EOF
    install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${layout_tmp}" "${layout_file}"
    rm -f "${layout_tmp}"
}

refresh_pcmanfm_desktop() {
    if ! pgrep -u "${QUADRF_USER}" -x pcmanfm >/dev/null 2>&1; then
        return 0
    fi
    display="$(ps -u "${QUADRF_USER}" -o args= 2>/dev/null |
        sed -n 's/.*Xvnc :\([0-9][0-9]*\).*/\1/p' | head -n1)"
    display="${display:-1}"
    runuser -u "${QUADRF_USER}" -- env \
        DISPLAY=":${display}" \
        XAUTHORITY="${HOME_DIR}/.Xauthority" \
        bash -c 'killall pcmanfm 2>/dev/null; exec pcmanfm --desktop --profile LXDE' \
        >/dev/null 2>&1 &
}

stamp_desktop_order
write_desktop_layout
refresh_pcmanfm_desktop
