#!/bin/bash
if command -v pulseaudio >/dev/null 2>&1; then
    # Default exit-idle-time is 20s. QRadioLink then hits a dead server on
    # RX start and the Qt audio/PortAudio setup can stall the event loop.
    pulseaudio --start --exit-idle-time=-1 --log-target=syslog 2>/dev/null || true
fi
pcmanfm --desktop --profile LXDE &
tint2 -c "${HOME}/.config/tint2/tint2rc" &
