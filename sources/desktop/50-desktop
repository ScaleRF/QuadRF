#!/bin/sh
# Lay out the KasmVNC session for the operator account: window manager config,
# panel, desktop launchers and the QuadRF web UI overlay.
set -eu

. /usr/share/quadrf/functions.sh
quadrf_load_conf

SHARE=/usr/share/quadrf/desktop
KASM_WWW=/usr/share/kasmvnc/www

if ! getent passwd "${QUADRF_USER}" >/dev/null; then
    echo "quadrf: user ${QUADRF_USER} does not exist, skipping desktop setup" >&2
    exit 0
fi

HOME_DIR="$(getent passwd "${QUADRF_USER}" | cut -d: -f6)"
GROUP="$(id -gn "${QUADRF_USER}")"

quadrf_user_dropin quadrf-desktop.service

# KasmVNC reads /etc/ssl/private/ssl-cert-snakeoil.key for its own TLS.
if getent group ssl-cert >/dev/null; then
    adduser --quiet "${QUADRF_USER}" ssl-cert || true
fi
# renderD128 is 0660 root:render. Xvnc is started as QUADRF_USER with
# -drinode /dev/dri/renderD128. Do not add video: that is card*/HDMI KMS,
# and Qt/SDL/mpv will then become DRM master on a plugged-in monitor
# instead of drawing on KasmVNC :1.
if getent group render >/dev/null; then
    adduser --quiet "${QUADRF_USER}" render || true
fi

# install -o takes a user name only; pair it with -g for the group.
install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${HOME_DIR}/.vnc" "${HOME_DIR}/Desktop"
install -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${SHARE}/xstartup" "${HOME_DIR}/.vnc/xstartup"
install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${SHARE}/kasmvnc.yaml" "${HOME_DIR}/.vnc/kasmvnc.yaml"

# KasmVNC otherwise prompts for a desktop environment on first start.
touch "${HOME_DIR}/.vnc/.de-was-selected"
chown "${QUADRF_USER}:${GROUP}" "${HOME_DIR}/.vnc/.de-was-selected"

# install -d -o only owns the last component; intermediates stay root and
# then qradiolink/GRC cannot create ~/.config/<app>.
install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${HOME_DIR}/.config"
for entry in openbox/autostart tint2/tint2rc pcmanfm/LXDE/pcmanfm.conf libfm/libfm.conf mimeapps.list; do
    src="${SHARE}/config/${entry}"
    dest="${HOME_DIR}/.config/${entry}"
    [ -f "${src}" ] || continue
    install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "$(dirname "${dest}")"
    install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${src}" "${dest}"
done
chown -R "${QUADRF_USER}:${GROUP}" "${HOME_DIR}/.config"
chmod 755 "${HOME_DIR}/.config/openbox/autostart" 2>/dev/null || true

# Compiled default is Pluto. The Soapy dropdown also offers the ZMQ thin
# client (driver=quadrf), which has no quadrfd. Seed MIPI on first run;
# rewrite those leftovers on apply.
# 4e6 Hz / 8192-pt FFT: (the default 1 Msps and 65536-pt FFT is too much.
qrl_cfg="${HOME_DIR}/.config/qradiolink/qradiolink.cfg"
qrl_src="${SHARE}/config/qradiolink/qradiolink.cfg"
if [ -f "${qrl_src}" ]; then
    install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "$(dirname "${qrl_cfg}")"
    if [ ! -f "${qrl_cfg}" ]; then
        install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${qrl_src}" "${qrl_cfg}"
    elif grep -qE 'driver=plutosdr|driver=quadrf' "${qrl_cfg}"; then
        sed -i \
            -e 's|^rx_device_args = .*|rx_device_args = "soapy=0,driver=mipi";|' \
            -e 's|^tx_device_args = .*|tx_device_args = "soapy=0,driver=mipi";|' \
            -e 's|^rx_antenna = .*|rx_antenna = "RX";|' \
            -e 's|^tx_antenna = .*|tx_antenna = "TX";|' \
            -e 's|^rx_sample_rate = .*|rx_sample_rate = 4000000L;|' \
            -e 's|^fft_size = .*|fft_size = 8192;|' \
            "${qrl_cfg}"
        chown "${QUADRF_USER}:${GROUP}" "${qrl_cfg}"
    fi
fi

# GRC File Open lists GTK bookmarks in the left pane. Keep one entry for the
# packaged flowgraphs; drop the unlabeled "grc" cwd shortcut by not setting
# Path= on the launcher.
gtk_dir="${HOME_DIR}/.config/gtk-3.0"
install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${gtk_dir}"
bookmarks="${gtk_dir}/bookmarks"
grc_uri="file:///usr/share/quadrf/grc"
grc_label="GNURadio QuadRF Examples"
bookmark_tmp="$(mktemp)"
if [ -f "${bookmarks}" ]; then
    grep -vF "${grc_uri}" "${bookmarks}" > "${bookmark_tmp}" || true
else
    : > "${bookmark_tmp}"
fi
printf '%s %s\n' "${grc_uri}" "${grc_label}" >> "${bookmark_tmp}"
install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${bookmark_tmp}" "${bookmarks}"
rm -f "${bookmark_tmp}"

# Generated qt_gui flowgraphs are a separate python3 process. GRC is nearly
# fullscreen on the VNC framebuffer, so without raise the spectrum window
# maps behind the editor.
ob_dir="${HOME_DIR}/.config/openbox"
install -d -o "${QUADRF_USER}" -g "${GROUP}" -m 755 "${ob_dir}"
ob_rc="${ob_dir}/rc.xml"
if [ ! -f "${ob_rc}" ] && [ -f /etc/xdg/openbox/rc.xml ]; then
    install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 /etc/xdg/openbox/rc.xml "${ob_rc}"
fi
if [ -f "${ob_rc}" ] && ! grep -q "quadrf: raise GNU Radio" "${ob_rc}"; then
    ob_tmp="$(mktemp)"
    awk '
        /<\/applications>/ && !done {
            print "  <!-- quadrf: raise GNU Radio generated Qt windows -->"
            print "  <application class=\"python3\">"
            print "    <focus>yes</focus>"
            print "    <raise>yes</raise>"
            print "  </application>"
            done = 1
        }
        { print }
    ' "${ob_rc}" > "${ob_tmp}"
    install -o "${QUADRF_USER}" -g "${GROUP}" -m 644 "${ob_tmp}" "${ob_rc}"
    rm -f "${ob_tmp}"
fi

/usr/lib/quadrf/sync-desktop-apps

if [ ! -f "${HOME_DIR}/.kasmpasswd" ] && command -v kasmvncpasswd >/dev/null 2>&1; then
    # Local session account. nginx fronts KasmVNC with -disableBasicAuth, so
    # this is not the credential that protects the appliance.
    printf 'quadrf\nquadrf\n' |
        runuser -u "${QUADRF_USER}" -- kasmvncpasswd -u "${QUADRF_USER}" -w \
            -o "${HOME_DIR}/.kasmpasswd" >/dev/null 2>&1 || true
fi

# QuadRF branding for the KasmVNC web client. Reapply after a kasmvncserver
# upgrade restores the vendor files.
if [ -d "${KASM_WWW}" ] && [ -d "${SHARE}/www" ]; then
    cp -a "${SHARE}/www/." "${KASM_WWW}/"
fi

# SVG launchers need the rsvg pixbuf loader registered; otherwise icons are blank.
loader="$(command -v gdk-pixbuf-query-loaders 2>/dev/null || true)"
if [ -z "${loader}" ]; then
    for cand in /usr/lib/*/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders; do
        [ -x "${cand}" ] || continue
        loader="${cand}"
        break
    done
fi
if [ -n "${loader}" ]; then
    "${loader}" --update-cache >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
fi
