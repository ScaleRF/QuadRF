#!/usr/bin/python3
"""Start, stop and report registered QuadRF applications.

CSI/DSI are single-client. Starting one app stops the others in the catalog
before the new unit is brought up. Invoked by the web GUI through sudoers.
"""
import argparse
import grp
import json
import os
import pwd
import re
import socket
import subprocess
import sys
import time
from configparser import ConfigParser, Error as ConfigParserError
from glob import glob

CATALOG_PATH = os.environ.get("QUADRF_APPS_JSON", "/usr/share/quadrf/apps.json")
CATALOG_DIR = os.environ.get("QUADRF_APPS_DIR", "/usr/share/quadrf/apps.d")
DESKTOP_ENTRY_DIRS = tuple(filter(None, os.environ.get(
    "QUADRF_DESKTOP_ENTRY_DIRS",
    "/usr/local/share/applications:/usr/share/applications",
).split(":")))
APP_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
# Bundled radio apps stay left of drop-ins, whose files sort by name.
PREFERRED_APP_IDS = ("ar", "ntsc", "psd", "nearfield")
CSI_RELEASE_S = 0.5
STOP_WAIT_S = 4.0
START_WAIT_S = 8.0


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"quadrf-app: {msg}", file=sys.stderr)


def read_catalog(path, required=False):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        if required:
            die(f"catalog missing: {path}")
        return None
    except json.JSONDecodeError as e:
        if required:
            die(f"catalog invalid: {path}: {e}")
        warn(f"ignoring invalid catalog {path}: {e}")
        return None


def load_catalog():
    paths = []
    if os.path.isfile(CATALOG_PATH):
        paths.append((CATALOG_PATH, True))
    paths.extend((path, False) for path in sorted(glob(os.path.join(CATALOG_DIR, "*.json"))))
    if not paths:
        die(f"no application catalogs found at {CATALOG_PATH} or {CATALOG_DIR}")

    by_id = {}
    for path, required in paths:
        data = read_catalog(path, required=required)
        if data is None:
            continue
        apps = data.get("apps") if isinstance(data, dict) else None
        if not isinstance(apps, list):
            warn(f"ignoring catalog without an apps list: {path}")
            continue
        for app in apps:
            if not isinstance(app, dict):
                warn(f"ignoring non-object entry in {path}")
                continue
            app_id = app.get("id")
            service = app.get("service")
            if (
                not isinstance(app_id, str)
                or not APP_ID_RE.fullmatch(app_id)
                or not isinstance(service, str)
                or not service
            ):
                warn(f"ignoring entry without id/service in {path}")
                continue
            if app_id in by_id:
                warn(f"ignoring duplicate app id {app_id!r} in {path}")
                continue
            by_id[app_id] = app
    return by_id


def desktop_metadata(app):
    entry_name = app.get("desktop_entry") or ""
    if not entry_name or entry_name != os.path.basename(entry_name) or not entry_name.endswith(".desktop"):
        return {}
    for directory in DESKTOP_ENTRY_DIRS:
        path = os.path.join(directory, entry_name)
        if not os.path.isfile(path):
            continue
        parser = ConfigParser(interpolation=None, strict=False)
        try:
            parser.read(path, encoding="utf-8")
            entry = parser["Desktop Entry"]
        except (OSError, KeyError, ConfigParserError):
            return {}
        return {
            "name": entry.get("Name", "").strip(),
            "blurb": entry.get("Comment", "").strip(),
            "icon": entry.get("Icon", "").strip(),
        }
    return {}


def run(cmd, check=False):
    return subprocess.run(cmd, check=check, capture_output=True, text=True)


def unit_exists(unit):
    r = run(["systemctl", "list-unit-files", "--no-legend", unit])
    return r.returncode == 0 and unit in (r.stdout or "")


def unit_active(unit):
    return run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def binary_running(name):
    return run(["pgrep", "-x", name]).returncode == 0


def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=0.2):
            return True
    except OSError:
        return False


def wait_until(pred, timeout, interval=0.1):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if pred():
            return True
        time.sleep(interval)
    return pred()


def stop_binaries(app):
    for name in app.get("binaries") or []:
        run(["pkill", "-x", name])


def stop_app(app):
    unit = app["service"]
    if unit_exists(unit):
        run(["systemctl", "stop", unit])
        run(["systemctl", "reset-failed", unit])
        wait_until(lambda: not unit_active(unit), STOP_WAIT_S)
    stop_binaries(app)
    wait_until(lambda: not any(binary_running(b) for b in (app.get("binaries") or [])), 2.0)


def start_app(app):
    unit = app["service"]
    if not unit_exists(unit):
        die(f"{app['id']}: {unit} is not installed", 2)
    r = run(["systemctl", "start", unit])
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip() or f"systemctl start {unit} failed"
        die(err, 1)
    if not wait_until(lambda: unit_active(unit), START_WAIT_S):
        st = run(["systemctl", "is-active", unit])
        die(f"{app['id']}: {unit} did not become active ({(st.stdout or '').strip()})", 1)
    ready_port = app.get("ready_port")
    if ready_port:
        if not wait_until(lambda: port_open(ready_port), START_WAIT_S):
            die(f"{app['id']}: listening port {ready_port} did not open", 1)


def status_payload(catalog):
    apps = []
    for app_id, app in catalog.items():
        metadata = desktop_metadata(app)
        unit = app["service"]
        installed = unit_exists(unit)
        running = False
        if installed:
            running = unit_active(unit)
        if not running:
            running = any(binary_running(b) for b in (app.get("binaries") or []))
        apps.append({
            "id": app_id,
            "name": metadata.get("name") or app.get("name") or app_id,
            "blurb": metadata.get("blurb") or app.get("blurb") or "",
            "icon": metadata.get("icon") or app.get("icon") or "",
            "open": app.get("open") or "",
            "exclusive": bool(app.get("exclusive")),
            "installed": installed,
            "running": running,
        })
    rank = {app_id: i for i, app_id in enumerate(PREFERRED_APP_IDS)}
    apps.sort(key=lambda app: (0, rank[app["id"]]) if app["id"] in rank else (1, 0))
    return {"status": "ok", "apps": apps}


def cmd_status(catalog):
    json.dump(status_payload(catalog), sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_start(catalog, app_id):
    app = catalog.get(app_id)
    if not app:
        die(f"unknown app: {app_id}", 2)
    for other_id, other in catalog.items():
        if other_id == app_id:
            continue
        if app.get("exclusive") and other.get("exclusive"):
            stop_app(other)
    time.sleep(CSI_RELEASE_S)
    start_app(app)
    json.dump(status_payload(catalog), sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_stop(catalog, app_id):
    app = catalog.get(app_id)
    if not app:
        die(f"unknown app: {app_id}", 2)
    stop_app(app)
    json.dump(status_payload(catalog), sys.stdout)
    sys.stdout.write("\n")
    return 0


def get_quadrf_user():
    user = "dietpi"
    conf_path = os.environ.get("QUADRF_CONF", "/etc/quadrf/quadrf.conf")
    if os.path.isfile(conf_path):
        try:
            with open(conf_path, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("QUADRF_USER="):
                        val = line.split("=", 1)[1].strip(' "\'')
                        if val:
                            user = val
        except OSError:
            pass
    return user


def cmd_register(argv):
    if os.geteuid() != 0:
        die("quadrf-app register needs root (run with sudo)")

    parser = argparse.ArgumentParser(
        prog="quadrf-app register",
        description="Register a custom application on the desktop and web control panel",
    )
    parser.add_argument("--id", required=True, help="Unique application identifier (e.g. my-psd)")
    parser.add_argument("--name", required=True, help="Display name (e.g. 'My PSD')")
    parser.add_argument("--exec", required=True, dest="exec_path", help="Full path to executable (e.g. /usr/local/bin/my-psd)")
    parser.add_argument("--icon", default="quadrf-psd", help="Icon name (default: quadrf-psd)")
    parser.add_argument("--comment", default=None, help="Application description / tooltip")
    parser.add_argument("--exclusive", action="store_true", default=True, help="Stop other radio apps when starting (default: true)")
    parser.add_argument("--no-exclusive", action="store_false", dest="exclusive", help="Allow running concurrently with other radio apps")
    parser.add_argument("--open", default="desktop", choices=["desktop", "browser"], help="Where app opens: desktop or browser (default: desktop)")
    parser.add_argument("--desktop-entry", default=None, help="Desktop entry filename (default: <id>.desktop)")
    parser.add_argument("--service", default=None, help="Systemd unit name (default: <id>.service)")

    args = parser.parse_args(argv)

    if not APP_ID_RE.fullmatch(args.id):
        die(f"invalid app id: {args.id} (must match {APP_ID_RE.pattern})")

    exec_path = os.path.abspath(args.exec_path)
    if not os.path.isfile(exec_path):
        warn(f"executable does not exist yet: {exec_path}")

    binary_name = os.path.basename(exec_path)
    desktop_entry = args.desktop_entry or f"{args.id}.desktop"
    if not desktop_entry.endswith(".desktop"):
        desktop_entry += ".desktop"
    service_name = args.service or f"{args.id}.service"
    if not service_name.endswith(".service"):
        service_name += ".service"
    comment = args.comment or args.name

    user = get_quadrf_user()
    try:
        pw = pwd.getpwnam(user)
        home = pw.pw_dir
        group = grp.getgrgid(pw.pw_gid).gr_name
    except KeyError:
        home = f"/home/{user}"
        group = user

    # 1. Desktop Entry
    desktop_dir = "/usr/share/applications"
    os.makedirs(desktop_dir, exist_ok=True)
    desktop_file = os.path.join(desktop_dir, desktop_entry)
    with open(desktop_file, "w", encoding="utf-8") as f:
        f.write(
            f"[Desktop Entry]\n"
            f"Type=Application\n"
            f"Version=1.0\n"
            f"Name={args.name}\n"
            f"Comment={comment}\n"
            f"Exec={exec_path}\n"
            f"TryExec={exec_path}\n"
            f"Icon={args.icon}\n"
            f"Terminal=false\n"
            f"Categories=HamRadio;Science;\n"
            f"X-QuadRF-Desktop=true\n"
        )
    os.chmod(desktop_file, 0o644)

    # 2. Systemd Service
    systemd_dir = "/etc/systemd/system"
    os.makedirs(systemd_dir, exist_ok=True)
    service_file = os.path.join(systemd_dir, service_name)
    with open(service_file, "w", encoding="utf-8") as f:
        f.write(
            f"[Unit]\n"
            f"Description={args.name}\n"
            f"Wants=load-quadrf.service quadrf-desktop.service\n"
            f"After=load-quadrf.service quadrf-desktop.service\n\n"
            f"[Service]\n"
            f"Type=simple\n"
            f"User={user}\n"
            f"Group={group}\n"
            f"Environment=HOME={home}\n"
            f"Environment=DISPLAY=:1\n"
            f"Environment=XAUTHORITY={home}/.Xauthority\n"
            f"Environment=SDL_VIDEODRIVER=x11\n"
            f"ExecStart={exec_path}\n"
            f"TimeoutStopSec=8\n"
            f"Restart=no\n"
        )
    os.chmod(service_file, 0o644)

    # 3. Catalog JSON Descriptor
    os.makedirs(CATALOG_DIR, exist_ok=True)
    catalog_file = os.path.join(CATALOG_DIR, f"{args.id}.json")
    catalog_data = {
        "apps": [
            {
                "id": args.id,
                "desktop_entry": desktop_entry,
                "service": service_name,
                "binaries": [binary_name],
                "exclusive": bool(args.exclusive),
                "open": args.open,
            }
        ]
    }
    with open(catalog_file, "w", encoding="utf-8") as f:
        json.dump(catalog_data, f, indent=2)
        f.write("\n")
    os.chmod(catalog_file, 0o644)

    # 4. Reload systemd and sync desktop entries
    run(["systemctl", "daemon-reload"])
    sync_script = "/usr/lib/quadrf/sync-desktop-apps"
    if os.path.isfile(sync_script) and os.access(sync_script, os.X_OK):
        run([sync_script])

    print(f"Registered application '{args.id}' successfully.")
    print(f"  Desktop entry: {desktop_file}")
    print(f"  Service unit:  {service_file}")
    print(f"  Descriptor:    {catalog_file}")
    return 0


def cmd_unregister(argv):
    if os.geteuid() != 0:
        die("quadrf-app unregister needs root (run with sudo)")

    parser = argparse.ArgumentParser(
        prog="quadrf-app unregister",
        description="Unregister a custom application from the desktop and web control panel",
    )
    parser.add_argument("id", help="Application identifier to remove")
    args = parser.parse_args(argv)

    catalog = load_catalog()
    app = catalog.get(args.id)
    if app:
        stop_app(app)
        desktop_entry = app.get("desktop_entry")
        service_name = app.get("service")
    else:
        desktop_entry = None
        service_name = None

    # Remove catalog descriptor
    catalog_file = os.path.join(CATALOG_DIR, f"{args.id}.json")
    if os.path.isfile(catalog_file):
        try:
            os.remove(catalog_file)
        except OSError as e:
            warn(f"could not remove {catalog_file}: {e}")

    # Remove systemd service
    for svc in filter(None, [service_name, f"{args.id}.service"]):
        service_file = os.path.join("/etc/systemd/system", svc)
        if os.path.isfile(service_file):
            try:
                os.remove(service_file)
            except OSError as e:
                warn(f"could not remove {service_file}: {e}")

    # Remove desktop entry
    for de in filter(None, [desktop_entry, f"{args.id}.desktop", f"com.example.{args.id}.desktop"]):
        desktop_file = os.path.join("/usr/share/applications", de)
        if os.path.isfile(desktop_file):
            try:
                os.remove(desktop_file)
            except OSError as e:
                warn(f"could not remove {desktop_file}: {e}")

    # Reload systemd and sync desktop entries
    run(["systemctl", "daemon-reload"])
    sync_script = "/usr/lib/quadrf/sync-desktop-apps"
    if os.path.isfile(sync_script) and os.access(sync_script, os.X_OK):
        run([sync_script])

    print(f"Unregistered application '{args.id}'.")
    return 0


def usage():
    print(
        "usage: quadrf-app status\n"
        "       quadrf-app start <app>\n"
        "       quadrf-app stop <app>\n"
        "       quadrf-app register --id <id> --name <name> --exec <path> [options]\n"
        "       quadrf-app unregister <id>",
        file=sys.stderr,
    )
    return 2


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        return usage()
    cmd = argv[0]
    if cmd in ("status", "list"):
        catalog = load_catalog()
        return cmd_status(catalog)
    if cmd in ("start", "stop"):
        if len(argv) < 2:
            return usage()
        catalog = load_catalog()
        app_id = argv[1]
        if cmd == "start":
            return cmd_start(catalog, app_id)
        return cmd_stop(catalog, app_id)
    if cmd == "register":
        return cmd_register(argv[1:])
    if cmd == "unregister":
        return cmd_unregister(argv[1:])
    return usage()


if __name__ == "__main__":
    sys.exit(main())
