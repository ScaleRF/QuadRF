[Unit]
Description=QuadRF mDNS alias for the remote desktop
After=avahi-daemon.service dbus.service network-online.target
Wants=avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/sbin/quadrf-mdns-alias
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
