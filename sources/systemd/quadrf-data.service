[Unit]
Description=802.11 OFDM Link
Wants=load-quadrf.service
After=load-quadrf.service

[Service]
Type=simple
User=dietpi
Group=dietpi
Environment=HOME=/home/dietpi
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ExecStart=/usr/bin/quadrf-data --port 8092
KillSignal=SIGINT
TimeoutStopSec=5
Restart=no

[Install]
WantedBy=multi-user.target
