[Unit]
Description=QuadRF FPGA bring-up
Documentation=man:quadrf(1)
After=local-fs.target
ConditionPathExists=|/usr/share/quadrf/fpga/quadrf-45.svf
ConditionPathExists=|/usr/share/quadrf/fpga/quadrf-25.svf
ConditionPathExists=|/usr/share/quadrf/fpga/quadrf.svf

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=process
ExecStart=/usr/sbin/quadrf-load
ExecStart=-/usr/bin/bist

[Install]
WantedBy=multi-user.target
