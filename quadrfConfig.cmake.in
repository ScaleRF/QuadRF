# Installed as QuadRFConfig.cmake so find_package(QuadRF) resolves.

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(SOAPY_SDR REQUIRED IMPORTED_TARGET SoapySDR)

# Apps link SoapySDR, which loads the QuadRF modules at runtime.
# QuadRF::quadrf adds headers such as fpga_csi.h and Farrow.hpp.

get_filename_component(QUADRF_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../include/quadrf" ABSOLUTE)
set(QuadRF_INCLUDE_DIRS "${QUADRF_INCLUDE_DIR}")

if(NOT TARGET QuadRF::quadrf)
    add_library(QuadRF::quadrf INTERFACE IMPORTED)
    set_target_properties(QuadRF::quadrf PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${QUADRF_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "PkgConfig::SOAPY_SDR"
    )
endif()
