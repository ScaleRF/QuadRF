# Versions of the third-party artefacts that ship in the QuadRF apt repository.
# Update the checksum whenever a version changes.

# OpenOCD with the Raspberry Pi 5 GPIO support used to program the ECP5.
OPENOCD_REPO=https://github.com/raspberrypi/openocd.git
OPENOCD_COMMIT=cd4873400c881ce3019c74620afb19e964a1f235
OPENOCD_VERSION=0.12.0+rpi.20250615

# QRadioLink is not in Debian. Built from upstream (own debian/) into our repo
# so the KasmVNC desktop launcher has a binary to run.
QRADIOLINK_REPO=https://codeberg.org/qradiolink/qradiolink.git
QRADIOLINK_COMMIT=eead06ad8d180288feffdab60af35039c40002d7
QRADIOLINK_VERSION=0.10.2-1

# KasmVNC is not in Debian, so the upstream package is mirrored in our repo.
KASMVNC_VERSION=1.4.0
KASMVNC_SUITE=trixie
KASMVNC_ARCH=arm64
KASMVNC_SHA256=aa7b20b69e239e0c6f50883e90665c24627a27fd9b3d37a421239ef5b8dfadae

# QuadRF Mesh (LoRa PHY, meshtasticd, desktop/control-panel launcher).
# Mirrored from the upstream GitHub release; not built in this tree.
# The quadrf metapackage Depends on this version. To take a new mesh:
#   ./packaging/thirdparty/pin-quadrf-mesh.sh          # latest release
#   ./packaging/thirdparty/pin-quadrf-mesh.sh v0.1.6
# then commit pins.env and tag a QuadRF release.
QUADRF_MESH_REPO=https://github.com/radioroy/quadrf-mesh
QUADRF_MESH_VERSION=0.1.9-1
QUADRF_MESH_TAG=v0.1.9
QUADRF_MESH_SHA256=dc2802281702b1c2f317d0030acad818fb0caedd03ae4fdb82b4e2790b4523a0
QUADRF_MESH_LORA_PHY_SHA256=f6bd85b1cc8babf9e639ec5caefa49a7bd0e6930b5be9ced4313161a46d40352
QUADRF_MESH_MESHTASTICD_SHA256=cac49fbff2aef241c42cbdc08cd99aabe2f4aa6045d0db0c04efd9d056a5b651

# QuadRF PhaseGaze (swept-LO phase-gradient hemisphere viewer).
# Mirrored from the upstream GitHub release; not built in this tree.
# The quadrf metapackage Depends on this version. To take a new release:
#   ./packaging/thirdparty/pin-quadrf-phasegaze.sh          # latest release
#   ./packaging/thirdparty/pin-quadrf-phasegaze.sh v0.1.0
# then commit pins.env and tag a QuadRF release.
QUADRF_PHASEGAZE_REPO=https://github.com/radioroy/phasegaze
QUADRF_PHASEGAZE_VERSION=0.1.2-1
QUADRF_PHASEGAZE_TAG=v0.1.2
QUADRF_PHASEGAZE_SHA256=6827090be055fa4f7ac4cb97f96cba151afdc8d8dffd7f06004b0a3c48ce6e1b
